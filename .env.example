# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AGENT_JWT_SECRET=replace-with-a-separate-random-secret-at-least-32-characters-long
TOTP_ENCRYPTION_KEY=replace-with-a-third-random-secret-at-least-32-characters-long

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...
# CIT Microsoft OAuth. See docs/MICROSOFT_LOGIN.md before enabling Azure in Supabase.
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback
ALLOW_PRODUCTION_MAINTENANCE=false
# Set this to the Supabase project reference only during an approved maintenance window.
CONFIRM_SUPABASE_PROJECT=

# Optional: permit uploads remain pending for manual review when omitted.
OPENAI_API_KEY=
ENABLE_AI_PERMIT_REVIEW=false

# Send verification codes BEFORE creating a Supabase Auth account.
# Use your SMTP provider's credentials (not your Supabase API keys).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=PrintFlow <no-reply@your-verified-domain.com>
# Generate a random secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SIGNUP_OTP_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Physical daemon connects to the API and authenticates as the shop user.
PRINTFLOW_BACKEND_URL=http://localhost:3000

# Optional local override for DOCX conversion. Production Docker includes soffice.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
MAX_PDF_PAGES=1000
MAX_IMAGE_PIXELS=75000000
MAX_DOCX_ENTRIES=10000
MAX_DOCX_EXPANDED_BYTES=268435456
MAX_DOCX_ENTRY_BYTES=134217728
MAX_NORMALIZED_PDF_BYTES=104857600
MAX_CONCURRENT_CONVERSIONS=2
MAX_QUEUED_CONVERSIONS=20
ALLOW_LEGACY_DAEMON_AUTH=false

# Optional Windows agent release metadata shown in the clerk portal.
AGENT_WINDOWS_VERSION=0.1.5
AGENT_WINDOWS_DOWNLOAD_URL=
AGENT_WINDOWS_STORAGE_PATH=
AGENT_WINDOWS_SHA256=
AGENT_WINDOWS_PUBLISHED_AT=
